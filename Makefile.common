# pcsx2/GS/Renderers/SW - software renderer. The device + texture cache/texture
# build everywhere; the scanline JIT (GS*CodeGenerator) and rasterizer are x86
# xbyak codegen with no arm64 backend, so they are dropped on aarch64 (the HW
# renderer / paraLLEl-GS cover it; GS.cpp gates the SW path on ARCH_ARM64).
# Mirrors the `list(REMOVE_ITEM ... NOT _M_X86)` in pcsx2/CMakeLists.txt.
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDeviceSW.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSTextureCacheSW.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSTextureSW.cpp

# The rasterizer, the renderer and the scanline dispatcher are portable: they
# are written against GSVector4/4i, which have NEON implementations. Only the
# xbyak code generators are x86-only, and GSDrawScanline falls back to its C++
# reference path (CSetupPrim / CDrawScanline / CDrawEdge) without them.
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanline.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSRasterizer.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSRendererSW.cpp

ifneq ($(IS_ARM64), 1)
SOURCES_CXX += \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanlineCodeGenerator.all.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSDrawScanlineCodeGenerator.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSSetupPrimCodeGenerator.all.cpp \
	$(LRPS2_DIR)/GS/Renderers/SW/GSSetupPrimCodeGenerator.cpp
endif

