SOURCES_CXX :=
SOURCES_C   :=
SOURCES_CC  :=
SOURCES_ASM :=

# ----------------------------------------------------------------------------
# Directories
# ----------------------------------------------------------------------------
DEPS_DIR          := $(CORE_DIR)/3rdparty
LIBRETRO_DIR      := $(CORE_DIR)/libretro
LIBRETRO_COMM_DIR := $(LIBRETRO_DIR)/libretro-common
COMMON_DIR        := $(CORE_DIR)/common
LRPS2_DIR         := $(CORE_DIR)/pcsx2
PGS_DIR           := $(LRPS2_DIR)/GS/parallel-gs
GRANITE_DIR       := $(PGS_DIR)/Granite

# ----------------------------------------------------------------------------
# Include flags
# ----------------------------------------------------------------------------
# Mirrors what the cmake LIBRETRO=ON build resolves to for pcsx2_libretro/PCSX2/
# common targets.  Order matters: project headers first, then 3rdparty.
INCFLAGS := \
	-I$(CORE_DIR) \
	-I$(LRPS2_DIR) \
	-I$(LRPS2_DIR)/x86 \
	-I$(COMMON_DIR) \
	-I$(COMMON_DIR)/include \
	-I$(LIBRETRO_DIR) \
	-I$(LIBRETRO_COMM_DIR)/include \
	-I$(DEPS_DIR) \
	-I$(DEPS_DIR)/include \
	-I$(DEPS_DIR)/xbyak \
	-I$(DEPS_DIR)/d3d12memalloc/include

ifeq ($(HAVE_OPENGL), 1)
	INCFLAGS += -I$(DEPS_DIR)/glad/include
endif

ifeq ($(HAVE_VULKAN), 1)
	INCFLAGS += \
		-I$(DEPS_DIR)/vulkan-headers/include \
		-I$(DEPS_DIR)/glslang/glslang \
		-I$(DEPS_DIR)/glslang/include \
		-I$(GRANITE_DIR)/util \
		-I$(GRANITE_DIR)/math \
		-I$(GRANITE_DIR)/vulkan \
		-I$(GRANITE_DIR)/application/global \
		-I$(GRANITE_DIR)/third_party/volk \
		-I$(PGS_DIR)/gs
endif

# ----------------------------------------------------------------------------
# Defines mirroring cmake's LIBRETRO=ON Windows build
# ----------------------------------------------------------------------------
ifeq ($(HAVE_OPENGL), 1)
	ifeq ($(GLES3), 1)
		FLAGS += -DHAVE_OPENGLES -DHAVE_OPENGLES3 -DENABLE_OPENGL
	else ifeq ($(GLES), 1)
		FLAGS += -DHAVE_OPENGLES -DHAVE_OPENGLES2 -DENABLE_OPENGL
	else
		FLAGS += -DHAVE_OPENGL -DCORE -DENABLE_OPENGL
	endif
endif

ifeq ($(HAVE_VULKAN), 1)
	FLAGS += -DHAVE_VULKAN -DENABLE_VULKAN -DHAVE_PARALLEL_GS \
		 -DGRANITE_SHIPPING
endif

ifeq ($(NEED_THREADING), 1)
	FLAGS += -DWANT_THREADING -DHAVE_THREADS
endif

ifeq ($(FRONTEND_SUPPORTS_RGB565), 1)
	FLAGS += -DFRONTEND_SUPPORTS_RGB565
endif

# ----------------------------------------------------------------------------
# AArch64 (arm64) recompiler backend (PR #143)
# ----------------------------------------------------------------------------
# VIXL is the AArch64 code emitter (aarch64 target only). The arm64 recompiler
# TUs include its headers, so its include dir and the two VIXL config defines
# must be visible to the whole core, not just the VIXL objects -- cmake sets
# them PUBLIC on the vixl target for exactly this reason.
ifeq ($(IS_ARM64), 1)
	INCFLAGS += -I$(DEPS_DIR)/vixl/src
	FLAGS    += -D_ARCH_64=1 \
	            -DVIXL_INCLUDE_TARGET_AARCH64 \
	            -DVIXL_CODE_BUFFER_MMAP
endif

CFLAGS   += $(FLAGS)
CXXFLAGS += $(FLAGS)

# ============================================================================
# libretro-common (C)
# ============================================================================
SOURCES_C += \
	$(LIBRETRO_COMM_DIR)/compat/compat_posix_string.c \
	$(LIBRETRO_COMM_DIR)/file/retro_dirent.c \
	$(LIBRETRO_COMM_DIR)/features/features_cpu.c \
	$(LIBRETRO_COMM_DIR)/file/file_path_io.c \
	$(LIBRETRO_COMM_DIR)/compat/compat_strl.c \
	$(LIBRETRO_COMM_DIR)/compat/fopen_utf8.c \
	$(LIBRETRO_COMM_DIR)/encodings/encoding_utf.c \
	$(LIBRETRO_COMM_DIR)/file/file_path.c \
	$(LIBRETRO_COMM_DIR)/file/file_path_io.c \
	$(LIBRETRO_COMM_DIR)/streams/file_stream.c \
	$(LIBRETRO_COMM_DIR)/string/rstrtod.c \
	$(LIBRETRO_COMM_DIR)/string/stdstring.c \
	$(LIBRETRO_COMM_DIR)/time/rtime.c \
	$(LIBRETRO_COMM_DIR)/rthreads/rthreads.c \
	$(LIBRETRO_COMM_DIR)/queues/retro_spsc.c \
	$(LIBRETRO_COMM_DIR)/vfs/vfs_implementation.c

# ============================================================================
# libretro core entry points (C++)
# ============================================================================
SOURCES_CXX += \
	$(LIBRETRO_DIR)/main.cpp \
	$(LIBRETRO_DIR)/patches.cpp \
	$(LIBRETRO_DIR)/DEV9.cpp \
	$(LIBRETRO_DIR)/USB.cpp

# ============================================================================
# common
# ============================================================================
SOURCES_CXX += \
	$(COMMON_DIR)/AlignedMalloc.cpp \
	$(COMMON_DIR)/Console.cpp \
	$(COMMON_DIR)/FastJmp.cpp \
	$(COMMON_DIR)/FileSystem.cpp \
	$(COMMON_DIR)/HostSys.cpp \
	$(COMMON_DIR)/MemorySettingsInterface.cpp \
	$(COMMON_DIR)/Semaphore.cpp \
	$(COMMON_DIR)/SettingsWrapper.cpp \
	$(COMMON_DIR)/StringUtil.cpp \
	$(COMMON_DIR)/TextureDecompress.cpp \
	$(COMMON_DIR)/Threads.cpp

# common/emitter is the x86-only JIT code emitter. On aarch64 the recompilers
# that use it are gated out (VIXL is the arm64 emitter instead), so exclude it
# -- matches the `if(_M_X86)` guard in common/CMakeLists.txt. FastJmp.cpp above
# stays on both (it has an __aarch64__ path).
# The reference emitter implementation lives with the verification harness in
# tests/emitter/reference: it is what the byte oracles compare the C89 core
# against. The switched build (C89_EMITTER=1) emits everything through the
# header-only core in common/emitter/c89emit.h and compiles none of these.
ifneq ($(IS_ARM64), 1)
ifneq ($(C89_EMITTER), 1)
SOURCES_CXX += \
	$(CORE_DIR)/tests/emitter/reference/avx.cpp \
	$(CORE_DIR)/tests/emitter/reference/groups.cpp \
	$(CORE_DIR)/tests/emitter/reference/jmp.cpp \
	$(CORE_DIR)/tests/emitter/reference/legacy.cpp \
	$(CORE_DIR)/tests/emitter/reference/legacy_sse.cpp \
	$(CORE_DIR)/tests/emitter/reference/movs.cpp \
	$(CORE_DIR)/tests/emitter/reference/simd.cpp \
	$(CORE_DIR)/tests/emitter/reference/x86emitter.cpp
endif
endif

# Win32 variant of FastJmp uses a dedicated GAS source for MinGW
# (matches the FastJmp.asm MASM source used for the MSVC build).
ifeq ($(IS_WIN_MINGW), 1)
	SOURCES_ASM += $(COMMON_DIR)/FastJmp_mingw.S
endif

